# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airline_noshow
DB_TYPE=sqlite
# PostgreSQL roles. Keep these passwords distinct; Compose requires all four.
DB_ADMIN_USER=airline_admin
DB_ADMIN_PASSWORD=replace_with_generated_admin_password
DB_RUNTIME_USER=airline_runtime
DB_RUNTIME_PASSWORD=replace_with_generated_runtime_password
DB_MIGRATION_USER=airline_migrator
DB_MIGRATION_PASSWORD=replace_with_generated_migration_password

# Application Configuration
SECRET_KEY=your_flask_secret_key_min_32_characters
JWT_SECRET_KEY=your_jwt_secret_key_min_32_characters
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
FLASK_APP=run.py
FLASK_ENV=development
AUTO_CREATE_SCHEMA=true

# API Configuration
API_VERSION=v1
API_TITLE=Airline No-Show Prediction API
API_DESCRIPTION=Advanced ML-powered airline no-show prediction and decision support

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Model Configuration
MODEL_PATH=models/
MLFLOW_TRACKING_URI=mlruns/
EXPERIMENT_NAME=airline-noshow-prediction

# Overbooking Simulation
DEFAULT_COMPENSATION_COST=1500
DEFAULT_EMPTY_SEAT_COST=300
DEFAULT_DENIED_BOARDING_COST=5000

# Drift Monitoring
DRIFT_THRESHOLD=0.1
MONITORING_INTERVAL=3600